# Copy to .env on the server (chmod 600). Never commit the real .env.

# Public host name of the Werkbank (nginx-proxy vhost + Let's Encrypt certificate)
WOW_HOST=wow.example.org
# Contact address for Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.org

# Keycloak: issuer URL of the realm, and the Keycloak host (allowed as logout redirect target)
OIDC_ISSUER_URL=https://auth.example.org/realms/example
AUTH_HOST=auth.example.org

# Keycloak realm -> Clients -> wow -> Credentials -> Client secret
WOW_CLIENT_SECRET=change-me
# 32 bytes: openssl rand -base64 32 | head -c 32
WOW_COOKIE_SECRET=change-me
